diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index a3f9eca..559498f 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -5144,6 +5144,8 @@ static void menu_present(void)
         vp.TopLeftX = vp.TopLeftY = (float)(s_back_h / 60u);
     else if (corner == 2)                   /* a notice: top, centred */
         vp.TopLeftY = (float)(s_back_h / 12u);
+    else if (corner == 3)                   /* a subtitle: bottom, centred */
+        vp.TopLeftY = (float)s_back_h - vp.Height - (float)(s_back_h / 14u);
     vp.MinDepth = 0.0f;
     vp.MaxDepth = 1.0f;
     ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &s_back_rtv, NULL);
@@ -6316,6 +6318,10 @@ void nv2a_d3d11_movie_fill_set(int on) { InterlockedExchange(&s_movie_fill, on <
 int nv2a_d3d11_movie_fill(void) { return (int)s_movie_fill; }
 static wchar_t s_movie_path[MAX_PATH];
 static HANDLE s_movie_done;
+/* rdr-port: the subtitle due at a movie time in seconds (movies.c, from
+ * the game's own subtitle file), NULL for none; set before each movie. */
+static const char *(*s_movie_subt)(double secs);
+void nv2a_d3d11_movie_subtitles(const char *(*at)(double secs)) { s_movie_subt = at; }
 
 static int movie_skip_down(void)
 {
@@ -6508,10 +6514,13 @@ static int movie_run(const wchar_t *path)
         }
         if (!movie_mf_copy(m, tex, w, h))
             continue;
+        if (s_movie_subt)
+            xbox_MenuSubtitle(s_movie_subt(movie_mf_time(m)));
         movie_show(srv, w, h);
         frames++;
     }
     movie_mf_close(m);
+    xbox_MenuSubtitle(NULL);
     if (srv) ID3D11ShaderResourceView_Release(srv);
     if (tex) ID3D11Texture2D_Release(tex);
     xbox_InputKeysClear();           /* the skip key is not the game's */
