From f4955d1bf48912d07b0b9c62ad81998b421dd2f4 Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Sun, 8 Nov 2026 05:09:20 -0300
Subject: [PATCH 74/74] Movies: the game's own subtitles drawn over the MP4s
 (movie time, bottom band)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/host_menu.c     | 86 +++++++++++++++++++++++++++++++++++++++++
 src/d3d/host_menu.h     |  4 ++
 src/d3d/movie_mf.c      |  6 +++
 src/d3d/movie_mf.h      |  2 +
 src/d3d/nv2a_pb_d3d11.c |  9 +++++
 5 files changed, 107 insertions(+)

diff --git a/src/d3d/host_menu.c b/src/d3d/host_menu.c
index f793ec7..87e0555 100644
--- a/src/d3d/host_menu.c
+++ b/src/d3d/host_menu.c
@@ -692,6 +692,85 @@ out:
     return s_px;
 }
 
+/* rdr-port: a movie's subtitle (xbox_MenuSubtitle), from movies.c's cues
+ * over the MP4s: the game draws its own only over its Bink movies. */
+static char s_subt[512];
+
+void xbox_MenuSubtitle(const char *utf8)
+{
+    if (!utf8)
+        utf8 = "";
+    if (!strcmp(utf8, s_subt))
+        return;
+    snprintf(s_subt, sizeof s_subt, "%s", utf8);
+    s_sig = 0;
+}
+
+static const uint32_t *subt_pixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen)
+{
+    static char shown[512];
+    static unsigned shown_px;
+    wchar_t wl[2][256];
+    int nl = 0, lw[2] = {0, 0}, i;
+    unsigned fpx, W, H, lh;
+    const char *p = s_subt;
+
+    fpx = back_h / 30u;                    /* the bold font is 1.3 times this */
+    if (fpx < 14u) fpx = 14u;
+    if (fpx > 48u) fpx = 48u;
+    if (s_px && s_owner == 3 && fpx == shown_px && !strcmp(shown, s_subt))
+        goto out;
+    if (!make_fonts(fpx))
+        return NULL;
+    SelectObject(s_dc, s_font_big);
+    while (*p && nl < 2) {
+        const char *e = strchr(p, '\n');
+        int n = e ? (int)(e - p) : (int)strlen(p);
+        int k = n ? MultiByteToWideChar(CP_UTF8, 0, p, n, wl[nl], 255) : 0;
+        SIZE sz;
+        wl[nl][k] = 0;
+        if (k > 0) {
+            lw[nl] = GetTextExtentPoint32W(s_dc, wl[nl], k, &sz) ? (int)sz.cx : (int)(fpx * 20u);
+            nl++;
+        }
+        p = e ? e + 1 : p + n;
+    }
+    if (!nl)
+        return NULL;
+    lh = fpx * 17u / 10u;
+    W = (unsigned)(lw[0] > lw[1] ? lw[0] : lw[1]) + fpx * 2u;
+    H = lh * (unsigned)nl + fpx / 2u;
+    if (!make_surface(W, H, fpx))
+        return NULL;
+    snprintf(shown, sizeof shown, "%s", s_subt);
+    shown_px = fpx;
+    s_owner = 3;
+    s_sig = 0;                              /* the menu redraws when it opens */
+    fill(0, 0, (int)W, (int)H, RGB(0, 0, 0));
+    SelectObject(s_dc, s_font_big);
+    SetTextColor(s_dc, RGB(250, 245, 230));
+    for (i = 0; i < nl; i++) {
+        RECT r;
+        r.left = 0;
+        r.right = (LONG)W;
+        r.top = (LONG)(fpx / 4u + lh * (unsigned)i);
+        r.bottom = r.top + (LONG)lh;
+        DrawTextW(s_dc, wl[i], -1, &r, DT_CENTER | DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX);
+    }
+    GdiFlush();
+    /* The text opaque, the band behind it at 55%. */
+    for (i = 0; i < (int)(W * H); i++) {
+        uint32_t c = s_px[i] & 0x00FFFFFFu;
+        s_px[i] = c | (c ? 0xFF000000u : 0x8C000000u);
+    }
+    s_gen++;
+out:
+    *w = s_w;
+    *h = s_h;
+    *gen = s_gen;
+    return s_px;
+}
+
 const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen,
                                 int *corner)
 {
@@ -699,6 +778,13 @@ const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsig
     int i, y;
 
     *corner = 0;
+    if (!s_open && s_subt[0] && !(s_toast_until && GetTickCount64() < s_toast_until)) {
+        const uint32_t *px = subt_pixels(back_h, w, h, gen);
+        if (px) {
+            *corner = 3;
+            return px;
+        }
+    }
     if (!s_open && s_toast_until) {
         if (GetTickCount64() < s_toast_until) {
             *corner = 2;
diff --git a/src/d3d/host_menu.h b/src/d3d/host_menu.h
