--- a/src/d3d/movie_mf.h
+++ b/src/d3d/movie_mf.h
@@ -20,6 +20,8 @@ int  movie_mf_copy(movie_mf *m, ID3D11Texture2D *tex, UINT w, UINT h);
 /* 1 once it has ended; -1 on a decode error. */
 int  movie_mf_done(movie_mf *m);
