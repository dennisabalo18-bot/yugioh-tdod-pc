From bdf092d90ad83741d14496ffe76e3af3f282f647 Mon Sep 17 00:00:00 2001
From: adrianelmanya76 <adrianelmanya76@gmail.com>
Date: Fri, 6 Nov 2026 01:23:51 -0300
Subject: [PATCH 60/74] Ultrawide: scan every program batch for 2D (first
 vertex first), so text from a program first seen in 3D is squeezed every
 frame

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/nv2a_pb_d3d11.c | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index 3b9567e..1ff49b2 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -4247,7 +4247,12 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
             }
             have_x = 1;
         }
-    } else if (scan && d->program && nv2a_aspect_due(&vs->hp)) {
+    } else if (scan && d->program && (uw ? (vs->hp.n = 0, 1) : nv2a_aspect_due(&vs->hp))) {
+        /* rdr-port: ultrawide scans every program batch (n = 0 keeps the
+         * gate due). Gated, a program first seen drawing 3D was scanned one
+         * batch in 256, so its 2D text (the tutorial boxes) was squeezed in
+         * some frames and stretched in the rest. A 3D batch stops at its
+         * first vertex (its w is not a whole number), so it costs little. */
         int slot[NV2A_VS_MAX_INPUTS];
         unsigned nf4 = 0;
         for (i = 0; i < NV2A_VS_MAX_INPUTS; i++)
@@ -4261,10 +4266,22 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
             }
         }
         if ((size_t)count * nf4 * 4u <= hvf_cap) {
-            for (k = 0; k < count; k++)
+            int first_2d = 1;
+            if (uw && count > 1) {
+                /* the first vertex alone: a 3D batch ends here, before its
+                 * other vertices are gathered */
+                float q0, q1;
+                for (i = 0; i < nf4; i++)
+                    vtx_input(d, v, (unsigned)slot[i], lo, hvf + i * 4u);
+                first_2d = nv2a_aspect_scan(&vs->hp, (const uint32_t (*)[4])v->prog, v->start,
+                                            (float (*)[4])(uintptr_t)v->c, hvf, nf4, slot, 1,
+                                            NULL, &q0, &q1);
+                vs->hp.n = 0;
+            }
+            for (k = 0; first_2d && k < count; k++)
                 for (i = 0; i < nf4; i++)
                     vtx_input(d, v, (unsigned)slot[i], lo + k, hvf + ((size_t)k * nf4 + i) * 4u);
-            hp.two_d = have_x = nv2a_aspect_scan(&vs->hp, (const uint32_t (*)[4])v->prog,
+            hp.two_d = have_x = first_2d && nv2a_aspect_scan(&vs->hp, (const uint32_t (*)[4])v->prog,
                                                  v->start, (float (*)[4])(uintptr_t)v->c,
                                                  hvf, nf4, slot, count, NULL,
                                                  &lo_x, &hi_x);
