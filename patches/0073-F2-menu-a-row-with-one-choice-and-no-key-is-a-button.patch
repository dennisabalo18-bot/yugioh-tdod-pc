From 91c33ffdac08acd224121e642aa2d8bdd15a4335 Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:13:31 -0300
Subject: [PATCH 73/74] F2 menu: a row with one choice and no key is a button
 (Enter/click presses it)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/host_menu.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/d3d/host_menu.c b/src/d3d/host_menu.c
index 8466805..f793ec7 100644
--- a/src/d3d/host_menu.c
+++ b/src/d3d/host_menu.c
@@ -316,6 +316,16 @@ static void change(int d)
     n = choice_count(it);
     if (n <= 0)
         return;
+    /* rdr-port: a row with one choice and no key is a button: forward
+     * (Enter, Space, →, click) presses it; nothing saved. */
+    if (n == 1 && !it->key) {
+        if (d > 0) {
+            fprintf(stderr, "[MENU] %s\n", it->label);
+            fflush(stderr);
+            it->set(0);
+        }
+        return;
+    }
     c = it->get();
     if (c < 0 || c >= n)
         c = 0;
@@ -811,7 +821,10 @@ const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsig
         {
             char v[128];
             int c = it->get(), n = choice_count(it);
-            snprintf(v, sizeof v, "‹  %s  ›", c >= 0 && c < n ? TR(it->choices[c]) : "?");
+            if (n == 1 && !it->key)  /* a button (see change()) */
+                snprintf(v, sizeof v, "%s", TR(it->choices[0]));
+            else
+                snprintf(v, sizeof v, "‹  %s  ›", c >= 0 && c < n ? TR(it->choices[c]) : "?");
             text((int)pad, y, (int)(W - 2 * pad), (int)row, v, DT_RIGHT,
                  i == s_sel ? RGB(255, 225, 150) : RGB(225, 185, 120));
         }
