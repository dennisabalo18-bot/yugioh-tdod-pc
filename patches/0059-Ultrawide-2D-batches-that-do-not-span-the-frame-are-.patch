From 53b51522a55a2bf2d4c9a1140729424bbe3274ff Mon Sep 17 00:00:00 2001
From: adrianelmanya76 <adrianelmanya76@gmail.com>
Date: Fri, 6 Nov 2026 01:19:04 -0300
Subject: [PATCH 59/74] Ultrawide: 2D batches that do not span the frame are
 squeezed to the 16:9 band and clipped to it (HUD, menu text); RECOMP_MONITOR
 to test another monitor's shape

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/nv2a_pb_d3d11.c  | 63 +++++++++++++++++++++++++++++++++++++---
 src/kernel/kernel_xbox.c |  8 +++++
 2 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index 180a75b..3b9567e 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -654,6 +654,34 @@ static int wide_frame(const RenderTarget *rt)
     return rt && wide_tv() && (rt->w == 640 || rt->w == 720) && rt->h == 480;
 }
 
+/* rdr-port: ultrawide. The game widens its 3D and its movies to the
+ * monitor's shape itself (rdr-apex widescreen.c), but draws the HUD, the
+ * menus' text and the legal screen in 640x480 pixels for a 16:9 screen;
+ * shown at 21:9 those came out half again too wide. A 2D batch on the
+ * frame that does not span the whole width is pulled toward the centre by
+ * (16/9) / the monitor's ratio, so it keeps its 16:9 look; full-width ones
+ * (fades, letterbox bars, the menus' torn edges) still cover the screen.
+ * RDR_UW_HUD: 2 (default) every 2D batch, 1 pass-through ones only, 0 off.
+ * The HUD is drawn through vertex programs (2 is needed). */
+static int uw_frame(const RenderTarget *rt)
+{
+    extern int xbox_VideoWidescreen(void);
+    return wide_frame(rt) && !rt->pad && xbox_VideoWidescreen() == 2;
+}
+static int uw_hud(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("RDR_UW_HUD");
+        v = e && *e >= '0' && *e <= '2' ? *e - '0' : 2;
+    }
+    return v;
+}
+static float uw_squeeze(void)
+{
+    return (16.0f * (float)wide_ah()) / (9.0f * (float)wide_aw());
+}
+
 static int init(void)
 {
     static int tried;
@@ -3937,7 +3965,8 @@ static int skip_rt_overlay(const RenderTarget *rt)
  * (nv2a_aspect_map, nv2a_aspect_box; with pad 0 both are stock). cb is
  * the surface clip (nv2a_draw_box). */
 static void set_vp(const struct nv2a_pb_vsh *v, const struct nv2a_pb_gpu *g,
-                   const RenderTarget *rt, int place, int two_d, const uint32_t cb[4])
+                   const RenderTarget *rt, int place, int two_d, const uint32_t cb[4],
+                   float squeeze)
 {
     static uint8_t vp_shadow[80];
     static int vp_ok;
@@ -3949,6 +3978,10 @@ static void set_vp(const struct nv2a_pb_vsh *v, const struct nv2a_pb_gpu *g,
 
     nv2a_vp_consts_fill(v, g->format, rt->w, rt->h, rt->pad, &vc);
     nv2a_aspect_map(&vc, rt->w, rt->h, rt->pad, place);
+    /* rdr-port: ultrawide (uw_squeeze): x pulled toward the centre, so the
+     * piece keeps the 16:9 shape the game drew it for. */
+    vc.c[0] *= squeeze;
+    vc.c[4] *= squeeze;
     /* rdr-port: at render scale n, a guest edge on a pixel's centre (x.5:
      * the letterbox bars, the 2D quads) lands n/2 host pixels inside that
      * pixel's block and leaves its first host row or column uncovered: a
@@ -3981,6 +4014,15 @@ static void set_vp(const struct nv2a_pb_vsh *v, const struct nv2a_pb_gpu *g,
     sr.top = (LONG)hb[1];
     sr.right = (LONG)hb[2];
     sr.bottom = (LONG)hb[3];
+    if (squeeze < 1.0f) {
+        /* rdr-port: the squeezed frame's own columns only: a piece the game
+         * parks off screen (x < 0 or past 640) stays hidden. */
+        float hw = (float)(rt->w * rt->n);
+        LONG l = (LONG)(hw * (1.0f - squeeze) * 0.5f), r = (LONG)(hw * (1.0f + squeeze) * 0.5f + 0.5f);
+        if (sr.left < l) sr.left = l;
+        if (sr.right > r) sr.right = r;
+        if (sr.right < sr.left) sr.right = sr.left;
+    }
     if (!sc_on() || memcmp(&s_sc.sr, &sr, sizeof sr)) {
         ID3D11DeviceContext_RSSetScissorRects(s_ctx, 1, &sr);
         s_sc.sr = sr;
@@ -4000,7 +4042,7 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
     const struct nv2a_pb_gpu *g = nv2a_pb_gpu_state();
     const struct nv2a_pb_vsh *v = nv2a_pb_vsh_state();
     struct aspect_batch hp = {0, 0, NV2A_PLACE_CENTRE, 0, NULL};
-    int have_x = 0, tris = 0, flat = 0, scan;
+    int have_x = 0, tris = 0, flat = 0, scan, uw;
     float lo_x = 0, hi_x = 0;      /* hor+: a 2D batch's x range, surface pixels */
     D3D11_PRIMITIVE_TOPOLOGY topo;
     ID3D11Buffer *vbs[NV2A_VS_MAX_INPUTS];
@@ -4169,7 +4211,8 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
      * under it showing the scene. Not on a square target (a shadow or glow
      * map, orthographic but 3D): shifted there it drew sliver lines. With
      * no pad two_d only feeds that shift and snap_2d. */
-    scan = rt->pad || nv2a_snap_2d_on(rt->n) || (rt->n > 1 && rt->w != rt->h);
+    uw = uw_frame(rt);
+    scan = rt->pad || nv2a_snap_2d_on(rt->n) || (rt->n > 1 && rt->w != rt->h) || uw;
     tris = rt->pad && topo == D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST;
     if (tris && count > hxy_cap) {
         float (*grown)[2] = (float (*)[2])realloc(hxy, (size_t)count * sizeof *hxy);
@@ -4194,6 +4237,16 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
         hp.two_d = have_x = 1;
     } else if (!rt->pad && scan && !d->program) {
         hp.two_d = 1;
+        /* rdr-port: ultrawide needs the batch's x range (uw_squeeze) */
+        if (uw && (vs->inputs & 1u)) {
+            for (k = 0; k < count; k++) {
+                float o[4];
+                vtx_input(d, v, 0, lo + k, o);
+                if (!k || o[0] < lo_x) lo_x = o[0];
+                if (!k || o[0] > hi_x) hi_x = o[0];
+            }
+            have_x = 1;
+        }
     } else if (scan && d->program && nv2a_aspect_due(&vs->hp)) {
         int slot[NV2A_VS_MAX_INPUTS];
         unsigned nf4 = 0;
@@ -4390,7 +4443,9 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
          * in metal_on_draw. */
         flat = rt->pad && d->program && !hp.two_d && !v->depth_enable
                && aspect_flat(d, v, vs, rt, lo, count);
-        set_vp(v, g, rt, hp.place, hp.two_d || flat, cb);
+        set_vp(v, g, rt, hp.place, hp.two_d || flat, cb,
+               uw && hp.two_d && have_x && !hp.full_w
+               && (uw_hud() == 2 || (uw_hud() == 1 && !d->program)) ? uw_squeeze() : 1.0f);
         if (px_on()) {
             uint32_t before[4];
             int n;
diff --git a/src/kernel/kernel_xbox.c b/src/kernel/kernel_xbox.c
index 79b95aa..e218bcc 100644
--- a/src/kernel/kernel_xbox.c
+++ b/src/kernel/kernel_xbox.c
@@ -10,6 +10,7 @@
  */
 
 #include "kernel.h"
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
@@ -46,6 +47,13 @@ void xbox_VideoWideAspect(unsigned *w, unsigned *h)
     if (!sh) {
         unsigned mw = (unsigned)GetSystemMetrics(0 /* SM_CXSCREEN */);
         unsigned mh = (unsigned)GetSystemMetrics(1 /* SM_CYSCREEN */);
+        /* RECOMP_MONITOR=3440x1440: another monitor's shape, for tests */
+        const char *e = getenv("RECOMP_MONITOR");
+        unsigned ew, eh;
+        if (e && sscanf(e, "%ux%u", &ew, &eh) == 2 && ew && eh) {
+            mw = ew;
+            mh = eh;
+        }
         if (!mw || !mh || mw * 9u < mh * 20u) {
             mw = 43u;                       /* a 16:9 monitor: 3440x1440's */
             mh = 18u;
-- 
2.55.0.windows.3

