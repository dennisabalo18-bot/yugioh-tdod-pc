+/* ygo-port 2026-11-19 (the user: the AUTO plate "se apaga" while the name
+ * plate does not, and shows over the attack): the caller names a box of the
+ * game's frame (guest px: x0, y0, x1, y1; x1 <= x0: none) and gets the mean
+ * brightness of its pixels (0..1, one or two frames late; -1 none yet). Read
+ * from the frame itself through two small staging textures that take turns
+ * (the one copied the frame before is mapped without waiting). Only 8-bit
+ * RGBA/BGRA single-sample frames. auto.c: the player's name plate. */
+volatile float g_nv2a_muestra_caja[4];
+volatile float g_nv2a_muestra_luz = -1.0f;
+static void muestra_luz(const RenderTarget *rt)
+{
+    static ID3D11Texture2D *st[2];
+    static UINT sw[2], sh[2];
+    static DXGI_FORMAT sf[2];
+    static int turno, copiado[2];
+    D3D11_TEXTURE2D_DESC d;
+    D3D11_MAPPED_SUBRESOURCE m;
+    D3D11_BOX b;
+    float x0 = g_nv2a_muestra_caja[0], y0 = g_nv2a_muestra_caja[1];
+    float x1 = g_nv2a_muestra_caja[2], y1 = g_nv2a_muestra_caja[3];
+    unsigned n = rt->n ? rt->n : 1u;
+    int i = turno, o = turno ^ 1, j;
+    if (x1 <= x0 || y1 <= y0 || !rt->tex)
+        return;
+    ID3D11Texture2D_GetDesc(rt->tex, &d);
+    if (d.SampleDesc.Count != 1
+            || (d.Format != DXGI_FORMAT_R8G8B8A8_UNORM && d.Format != DXGI_FORMAT_B8G8R8A8_UNORM
+                && d.Format != DXGI_FORMAT_R8G8B8A8_UNORM_SRGB && d.Format != DXGI_FORMAT_B8G8R8A8_UNORM_SRGB
+                && d.Format != DXGI_FORMAT_B8G8R8X8_UNORM)) {
+        static int dicho;
+        if (!dicho) {
+            dicho = 1;
+            fprintf(stderr, LOGP "[MUESTRA] frame format %d / %u samples: brightness not read\n",
+                    (int)d.Format, d.SampleDesc.Count);
+        }
+        return;
+    }
+    /* the copies made before (older first), if the GPU is done with them */
+    for (j = 0; j < 2; j++) {
+        int q = j ? i : o;
+        if (copiado[q] && st[q]
+                && SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)st[q], 0, D3D11_MAP_READ,
+                                                     D3D11_MAP_FLAG_DO_NOT_WAIT, &m))) {
+            double s = 0.0;
+            UINT x, y;
+            for (y = 0; y < sh[q]; y++) {
+                const unsigned char *p = (const unsigned char *)m.pData + (size_t)y * m.RowPitch;
+                for (x = 0; x < sw[q]; x++)
+                    s += p[4 * x] + p[4 * x + 1] + p[4 * x + 2];
+            }
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)st[q], 0);
+            g_nv2a_muestra_luz = (float)(s / (3.0 * 255.0 * (double)sw[q] * (double)sh[q]));
+            copiado[q] = 0;
+        }
+    }
+    if (copiado[i])
+        return;                         /* both still in flight */
+    b.left = (UINT)((x0 + (float)rt->pad) * (float)n);
+    b.top = (UINT)(y0 * (float)n);
+    b.right = (UINT)((x1 + (float)rt->pad) * (float)n);
+    b.bottom = (UINT)(y1 * (float)n);
+    b.front = 0;
+    b.back = 1;
+    if (b.right > d.Width)
+        b.right = d.Width;
+    if (b.bottom > d.Height)
+        b.bottom = d.Height;
+    if (b.right <= b.left || b.bottom <= b.top)
+        return;
+    if (!st[i] || sw[i] != b.right - b.left || sh[i] != b.bottom - b.top || sf[i] != d.Format) {
+        D3D11_TEXTURE2D_DESC sd;
+        if (st[i])
+            ID3D11Texture2D_Release(st[i]);
+        st[i] = NULL;
+        memset(&sd, 0, sizeof sd);
+        sd.Width = b.right - b.left;
+        sd.Height = b.bottom - b.top;
+        sd.MipLevels = 1;
+        sd.ArraySize = 1;
+        sd.Format = d.Format;
+        sd.SampleDesc.Count = 1;
+        sd.Usage = D3D11_USAGE_STAGING;
+        sd.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &sd, NULL, &st[i])))
+            return;
+        sw[i] = sd.Width;
+        sh[i] = sd.Height;
+        sf[i] = d.Format;
+    }
+    ID3D11DeviceContext_CopySubresourceRegion(s_ctx, (ID3D11Resource *)st[i], 0, 0, 0, 0,
+                                              (ID3D11Resource *)rt->tex, 0, &b);
+    copiado[i] = 1;
+    turno = o;
+}
