+/* at the flip: the measures asked for */
+static void masc_flip(void)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        struct nv2a_mascota_kit *m = &g_nv2a_mascota[i];
+        int pedido = m->pedido, b[4], pies;
+        if (!m->activa) {
+            s_mk[i].visto = -1;
+            continue;
+        }
+        if (pedido != s_mk[i].visto) {
+            /* a new request (a new camera): a few frames for it to show */
+            s_mk[i].visto = pedido;
+            s_mk[i].esperar = 6;
+            s_mk[i].n = 0;
+            s_mk[i].bb[0] = s_mk[i].bb[1] = 480;
+            s_mk[i].bb[2] = s_mk[i].bb[3] = -1;
+            s_mk[i].ps = 0.;
+            s_mk[i].pn = 0;
+        }
+        if (m->medido == pedido || !m->off)
+            continue;
+        if (s_mk[i].esperar > 0) {
+            s_mk[i].esperar--;
+            continue;
+        }
+        if ((s_presents % 8u) != (uint64_t)i * 2u || !masc_bbox(m->off, b, &pies))
+            continue;
+        if (b[2] >= b[0]) {
+            if (b[0] < s_mk[i].bb[0]) s_mk[i].bb[0] = b[0];
+            if (b[1] < s_mk[i].bb[1]) s_mk[i].bb[1] = b[1];
+            if (b[2] > s_mk[i].bb[2]) s_mk[i].bb[2] = b[2];
+            if (b[3] > s_mk[i].bb[3]) s_mk[i].bb[3] = b[3];
+            if (pies >= 0) {
+                s_mk[i].ps += pies;
+                s_mk[i].pn++;
+            }
+        }
+        if (++s_mk[i].n >= MASC_MUESTRAS) {
+            int k;
+            for (k = 0; k < 4; k++)
+                m->bb[k] = s_mk[i].bb[k];
+            m->pies = s_mk[i].pn ? (int)(s_mk[i].ps / s_mk[i].pn + 0.5) : -1;
+            m->medido = pedido;
+            fprintf(stderr, LOGP "[MASC] %d: target %08X, the model fills u %d..%d, v %d..%d"
+                    " (%d samples)\n", i, m->off, m->bb[0], m->bb[2], m->bb[1], m->bb[3],
+                    s_mk[i].n);
+            fflush(stderr);
+        }
+    }
+}
