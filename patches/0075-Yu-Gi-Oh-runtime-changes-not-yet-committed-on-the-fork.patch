+/* the opaque extent of a 480x480 target, read back (every 2nd guest px) */
+static int masc_bbox(uint32_t off, int bb[4], int *pies)
+{
+    static ID3D11Texture2D *st;
+    static UINT st_w, st_h;
+    RenderTarget *rt = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE m;
+    UINT x, y, n;
+    int i;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].offset == off && s_rt[i].w == 480 && s_rt[i].h == 480)
+            rt = &s_rt[i];
+    if (!rt)
+        return 0;
+    ID3D11Texture2D_GetDesc(rt->tex, &td);
+    if (!st || st_w != td.Width || st_h != td.Height) {
+        if (st)
+            ID3D11Texture2D_Release(st);
+        st = NULL;
+        td.Usage = D3D11_USAGE_STAGING;
+        td.BindFlags = 0;
+        td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        td.MiscFlags = 0;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &st)))
+            return 0;
+        st_w = td.Width;
+        st_h = td.Height;
+    }
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)st, (ID3D11Resource *)rt->tex);
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)st, 0, D3D11_MAP_READ, 0, &m)))
+        return 0;
+    n = rt->n ? rt->n : 1;
+    bb[0] = bb[1] = 480;
+    bb[2] = bb[3] = -1;
+    for (y = 0; y < 480u; y += 2)
+        for (x = 0; x < 480u; x += 2) {
+            uint32_t p = *(const uint32_t *)((const uint8_t *)m.pData + (size_t)(y * n) * m.RowPitch
+                                             + (size_t)(rt->pad * n + x * n) * 4u);
+            if ((p >> 24) > 16u) {
+                if ((int)x < bb[0]) bb[0] = (int)x;
+                if ((int)y < bb[1]) bb[1] = (int)y;
+                if ((int)x + 1 > bb[2]) bb[2] = (int)x + 1;
+                if ((int)y + 1 > bb[3]) bb[3] = (int)y + 1;
+            }
+        }
+    *pies = -1;
+    if (bb[3] > bb[1]) {
+        /* the lowest rows only (16:0x: a tenth took in the bottom of a cape) */
+        int y0 = bb[3] - (bb[3] - bb[1]) / 25 - 4;
+        double sx = 0.;
+        unsigned c = 0;
+        for (y = (UINT)(y0 < 0 ? 0 : y0) & ~1u; y < (UINT)bb[3] && y < 480u; y += 2)
+            for (x = 0; x < 480u; x += 2) {
+                uint32_t p = *(const uint32_t *)((const uint8_t *)m.pData + (size_t)(y * n) * m.RowPitch
+                                                 + (size_t)(rt->pad * n + x * n) * 4u);
+                if ((p >> 24) > 16u) {
+                    sx += x;
+                    c++;
+                }
+            }
+        if (c)
+            *pies = (int)(sx / c + 0.5);
+    }
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)st, 0);
+    return 1;
+}
