+
+/* ygo-port 2026-11-19: the ace card (carta_as.c): a picture the size of the
+ * view, RGBA premultiplied, made each frame on the CPU by the game side (dim,
+ * the card, dust, light); laid over the frame (ONE, INV_SRC_ALPHA: what covers
+ * covers, the light is added). g_nv2a_as_mueve moves the frame (the shake),
+ * in parts of the view; g_nv2a_vista_w/h tell the game the view's size. */
+const unsigned char *volatile g_nv2a_as_px;              /* in front of the card */
+const unsigned char *volatile g_nv2a_as_fondo_px;        /* behind the card */
+volatile int g_nv2a_as_w, g_nv2a_as_h;
+volatile unsigned g_nv2a_as_ver;
+volatile float g_nv2a_as_mueve[2];
+volatile int g_nv2a_vista_w, g_nv2a_vista_h;
+/* 2026-11-19 (the user: the card "de mala calidad de cerca"): the card itself
+ * from its own texture (BGRA premultiplied, mipmapped), at the screen's size:
+ * canvas px -> uv (3x3), alpha (0: none), the canvas' w, h */
+const unsigned char *volatile g_nv2a_as_carta_px;
+volatile int g_nv2a_as_carta_w, g_nv2a_as_carta_h;
+volatile unsigned g_nv2a_as_carta_ver;
+volatile float g_nv2a_as_carta[12];
+/* the name's letters (the user: "la letra ... se ve borrosa"), the same way */
+const unsigned char *volatile g_nv2a_as_tit_px;
+volatile int g_nv2a_as_tit_w, g_nv2a_as_tit_h;
+volatile unsigned g_nv2a_as_tit_ver;
+volatile float g_nv2a_as_tit[12];
+/* the version of the pictures last drawn (the Perfil hides only once the first one is on screen) */
+volatile unsigned g_nv2a_as_dibujado;
+static const char s_as_ps_src[] =
+    "cbuffer A : register(b0) { float4 vp; float4 h0; float4 h1; float4 h2; };\n"
+    "Texture2D t : register(t0);\n"
+    "SamplerState s : register(s0);\n"
+    "float4 main(float4 p : SV_Position) : SV_Target {\n"
+    "    return t.SampleLevel(s, (p.xy - vp.xy) / vp.zw, 0);\n"
+    "}\n";
+/* the card: h0..h2 the rows of canvas px -> uv; h2.w alpha; h0.w, h1.w canvas w, h */
+static const char s_as_carta_src[] =
+    "cbuffer A : register(b0) { float4 vp; float4 h0; float4 h1; float4 h2; };\n"
+    "Texture2D t : register(t0);\n"
+    "SamplerState s : register(s0);\n"
+    "float4 main(float4 p : SV_Position) : SV_Target {\n"
+    "    float2 c = (p.xy - vp.xy) / vp.zw * float2(h0.w, h1.w);\n"
+    "    float3 q = float3(c, 1.0);\n"
+    "    float d = dot(h2.xyz, q);\n"
+    "    float2 uv = float2(dot(h0.xyz, q), dot(h1.xyz, q)) / d;\n"
+    "    float2 e = fwidth(uv);\n"
+    "    float2 m = min(uv, 1.0 - uv) / max(e, 1e-5);\n"
+    "    float cov = saturate(min(m.x, m.y) + 0.5);\n"
+    "    if (cov <= 0.0) discard;\n"
+    "    return t.Sample(s, saturate(uv)) * cov * h2.w;\n"
+    "}\n";
+static ID3D11PixelShader *s_as_ps, *s_as_carta_ps;
+static ID3D11Buffer *s_as_cb;
+static ID3D11Texture2D *s_as_tex[2];
+static ID3D11ShaderResourceView *s_as_srv[2];
+static ID3D11ShaderResourceView *s_as_carta_srv, *s_as_tit_srv;
+static ID3D11SamplerState *s_as_smp;     /* trilinear, all the mips */
+static unsigned s_as_carta_de, s_as_tit_de;
+static int s_as_tw, s_as_th, s_as_failed;
+static unsigned s_as_ver;
+
+static void as_pase(ID3D11PixelShader *ps, ID3D11ShaderResourceView *srv, ID3D11SamplerState *smp)
+{
+    ID3D11ShaderResourceView *none = NULL;
+    ID3D11DeviceContext_PSSetShader(s_ctx, ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_as_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 1, &smp);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);
+}
+
+/* a BGRA premultiplied picture to a mipmapped texture, once per version */
+static void as_textura(const unsigned char *px, int w, int h, unsigned ver, unsigned *de,
+                       ID3D11ShaderResourceView **srv)
+{
+    D3D11_TEXTURE2D_DESC td;
+    ID3D11Texture2D *tex = NULL;
+    if (*de == ver || !px || w <= 0 || h <= 0)
+        return;
+    *de = ver;
+    if (*srv)
+        ID3D11ShaderResourceView_Release(*srv);
+    *srv = NULL;
+    memset(&td, 0, sizeof td);
+    td.Width = (UINT)w;
+    td.Height = (UINT)h;
+    td.MipLevels = 0;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    td.MiscFlags = D3D11_RESOURCE_MISC_GENERATE_MIPS;
+    if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &tex))) {
+        ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)tex, 0, NULL, px, (UINT)w * 4u, 0);
+        if (SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tex, NULL, srv)))
+            ID3D11DeviceContext_GenerateMips(s_ctx, *srv);
+        ID3D11Texture2D_Release(tex);
+    }
+}
+
+/* the constants: the view's rect and a 3x3 + alpha + canvas size */
+static int as_constantes(const struct nv2a_rect *r, volatile float *hm)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    float d[16];
+    int k;
+    d[0] = (float)r->x;
+    d[1] = (float)r->y;
+    d[2] = (float)r->w;
+    d[3] = (float)r->h;
+    for (k = 0; k < 3; k++) {
+        d[4 + 4 * k] = hm[3 * k];
+        d[5 + 4 * k] = hm[3 * k + 1];
+        d[6 + 4 * k] = hm[3 * k + 2];
+    }
+    d[7] = hm[10];
+    d[11] = hm[11];
+    d[15] = hm[9];
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_as_cb, 0, D3D11_MAP_WRITE_DISCARD, 0, &m)))
+        return 0;
+    memcpy(m.pData, d, sizeof d);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_as_cb, 0);
+    return 1;
+}
+
+static void carta_as(const struct nv2a_rect *r)
+{
+    const unsigned char *px = g_nv2a_as_px, *fondo = g_nv2a_as_fondo_px;
+    int w = g_nv2a_as_w, h = g_nv2a_as_h, k;
+    D3D11_MAPPED_SUBRESOURCE m;
+    if (!px || !fondo || w <= 0 || h <= 0 || s_as_failed)
+        return;
+    if (!s_as_ps) {
