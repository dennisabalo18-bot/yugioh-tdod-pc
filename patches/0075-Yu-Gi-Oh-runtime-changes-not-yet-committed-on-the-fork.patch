+/* ygo-port 2026-11-15: the damage number ("-1500" by the life points), in the
+ * game's own life-point digits (the duel atlas's "0123456789-+" strip, handed
+ * over by the game as luminance + alpha with each glyph's box: danio.c). Per
+ * player: frame x, y of its middle (640x480), size, alpha; value, tint rgb.
+ * 2026-11-15: 8 of them: 0 and 1 the damage, 2..7 the chain numbers
+ * (cadena.c); a negative size draws the number without its sign. */
+#define DANO_N 8
+volatile float g_nv2a_dano[DANO_N][8];
+const unsigned char *volatile g_nv2a_dano_px;      /* R8G8, w x h; NULL: none */
+volatile int g_nv2a_dano_w, g_nv2a_dano_h;
+const int (*volatile g_nv2a_dano_caja)[2];         /* 12 glyphs: x0, x1 in its pixels */
+/* 2026-11-16 (the chain between the chain's cards, cadena.c): up to 8 chains,
+ * each frame x0, y0, x1, y1; alpha, how much of it is drawn (0..1 from x0),
+ * thickness (frame px), sway phase; sag (frame px, + down), sway (frame px),
+ * 0, 0. The picture: the user's chain (tools/cadena_tira.py: two links that
+ * repeat, RGBA, handed over by cadena.c), laid along a bowed line that sways
+ * ("no es derecha en ninguna parte, siempre con movimiento"); under the
+ * numbers and behind the chain's cards. */
+#define CADENA_N 8
+volatile float g_nv2a_cadena[CADENA_N][12];
+const unsigned char *volatile g_nv2a_cadena_px;    /* RGBA, w x h; NULL: none */
+/* the chain goes behind the chain's cards: their boxes (frame x, y of the
+ * middle, half width, half height (0 wide: none); cos, sin of their turn,
+ * 0, 0) hide it */
+volatile float g_nv2a_cadena_cartas[9][8];
+volatile int g_nv2a_cadena_w, g_nv2a_cadena_h;
+static const char s_dano_ps_src[] =
+    "cbuffer D : register(b0) { float4 vp; float4 tx; float4 n[16]; float4 caja[12]; float4 cad[24]; float4 rc[18]; };\n"
+    "Texture2D t : register(t0);\n"
+    "Texture2D tc : register(t1);\n"
+    "SamplerState s : register(s0);\n"
+    "float4 uno(float2 f, float4 a, float4 b) {\n"
+    "    float4 o = 0;\n"
+    "    int g[7]; int dg[6]; int c = 0, m = 0, k2;\n"
+    "    int iv = (int)(abs(b.x) + 0.5);\n"
+    "    float k = abs(a.z) * 0.25, w = 0, x, top;\n"
+    "    if (a.w <= 0.0) return o;\n"
+    "    [unroll] for (k2 = 0; k2 < 6; k2++) { dg[k2] = 0; }\n"
+    "    [unroll] for (k2 = 0; k2 < 7; k2++) { g[k2] = 0; }\n"
+    "    [loop] do { dg[c] = iv % 10; iv /= 10; c++; } while (iv > 0 && c < 6);\n"
+    "    if (a.z > 0.0) { g[0] = b.x < 0.0 ? 10 : 11; m = 1; }\n"
+    "    [loop] for (k2 = c - 1; k2 >= 0; k2--) { g[m] = dg[k2]; m++; }\n"
+    "    [loop] for (k2 = 0; k2 < m; k2++) w += caja[g[k2]].y - caja[g[k2]].x - tx.z;\n"
+    "    w += tx.z;\n"
+    "    x = a.x - w * k * 0.5;\n"
+    "    top = a.y - tx.y * k * 0.5;\n"
+    "    if (f.y < top || f.y >= top + tx.y * k) return o;\n"
+    "    [loop] for (k2 = 0; k2 < m; k2++) {\n"
+    "        float gw = caja[g[k2]].y - caja[g[k2]].x;\n"
+    "        if (f.x >= x && f.x < x + gw * k) {\n"
+    "            float2 uv = float2((caja[g[k2]].x + (f.x - x) / k) / tx.x, (f.y - top) / k / tx.y);\n"
+    "            float2 la = t.SampleLevel(s, uv, 0).rg;\n"
+    "            if (la.y > o.a) o = float4(la.x * b.yzw, la.y);\n"
+    "        }\n"
+    "        x += (gw - tx.z) * k;\n"
+    "    }\n"
+    "    o.a *= a.w;\n"
+    "    return o;\n"
+    "}\n"
+    "float4 eslabon(float2 f, float4 a, float4 b, float4 c) {\n"
+    "    float4 o = 0;\n"
+    "    float2 d = a.zw - a.xy; float L = length(d), T = max(b.z, 2.0), t, q, P, k, off;\n"
+    "    float2 u, v;\n"
+    "    if (b.x <= 0.0 || L < 1.0) return o;\n"
+    "    u = d / L; v = float2(-u.y, u.x);\n"
+    "    t = dot(f - a.xy, u); q = dot(f - a.xy, v);\n"
+    "    if (t < 0.0 || t > L * saturate(b.y)) return o;\n"
+    "    k = t / L;\n"
+    "    off = sin(3.14159 * k) * (c.x + c.y * sin(6.28318 * k + b.w));\n"
+    "    q -= off * (u.x >= 0.0 ? 1.0 : -1.0);\n"   /* + sags down on screen */
+    "    if (abs(q) > T * 0.5) return o;\n"
+    "    P = T * tx.w;\n"
+    "    o = tc.SampleLevel(s, float2(frac(t / P), q / T + 0.5), 0);\n"
+    "    o.a *= b.x;\n"
+    "    return o;\n"
+    "}\n"
+    "float4 main(float4 p : SV_Position) : SV_Target {\n"
+    "    float2 f = (p.xy - vp.xy) * float2(640.0 / vp.z, 480.0 / vp.w);\n"
+    "    float3 rgb = 0; float a = 0; int i;\n"
+    "    float4 ch = 0;\n"
+    "    [loop] for (i = 0; i < 8; i++) {\n"
+    "        float4 c = eslabon(f, cad[3 * i], cad[3 * i + 1], cad[3 * i + 2]);\n"
+    "        if (c.a > ch.a) ch = c;\n"
+    "    }\n"
+    "    [loop] for (i = 0; i < 9; i++) {\n"
+    "        float2 pc = f - rc[2 * i].xy, cs = rc[2 * i + 1].xy;\n"
+    "        float2 lc = float2(dot(pc, cs), dot(pc, float2(-cs.y, cs.x)));\n"
+    "        if (rc[2 * i].z > 0.0 && all(abs(lc) < rc[2 * i].zw)) ch = 0;\n"
+    "    }\n"
+    "    [loop] for (i = 0; i < 8; i++) {\n"
+    "        float4 c = uno(f, n[2 * i], n[2 * i + 1]);\n"
+    "        rgb += c.rgb * c.a * (1.0 - a); a += c.a * (1.0 - a);\n"
+    "    }\n"
+    "    rgb += ch.rgb * ch.a * (1.0 - a); a += ch.a * (1.0 - a);\n"   /* the chains under the numbers */
+    "    return float4(rgb, a);\n"   /* premultiplied */
+    "}\n";
+static ID3D11PixelShader *s_dano_ps;
+static ID3D11Buffer *s_dano_cb;
+static ID3D11BlendState *s_dano_bs;
+static ID3D11ShaderResourceView *s_dano_srv;
+static ID3D11ShaderResourceView *s_cadena_srv;
+static float s_cadena_aspecto;
+static int s_dano_failed;
+
+
+/* the premultiplied blend (ONE, INV_SRC_ALPHA), made by the damage pass or here */
+static int s_dano_bs_ok(void)
+{
+    D3D11_BLEND_DESC bd;
+    if (s_dano_bs)
+        return 1;
+    memset(&bd, 0, sizeof bd);
+    bd.RenderTarget[0].BlendEnable = TRUE;
+    bd.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+    bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+    bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ZERO;
+    bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+    bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    return SUCCEEDED(ID3D11Device_CreateBlendState(s_dev, &bd, &s_dano_bs));
+}
+
+static void dano(const struct nv2a_rect *r)
+{
+    float d[4 + 4 + 8 * DANO_N + 48 + 12 * CADENA_N + 72];
+    int i, alguno = 0;
+    D3D11_MAPPED_SUBRESOURCE m;
+    const unsigned char *px = g_nv2a_dano_px;
+    const int (*caja)[2] = g_nv2a_dano_caja;
+    for (i = 0; i < DANO_N; i++)
+        alguno |= g_nv2a_dano[i][3] > 0.0f;
+    for (i = 0; i < CADENA_N; i++)
+        alguno |= g_nv2a_cadena[i][4] > 0.0f && g_nv2a_cadena_px;
+    if (!alguno || s_dano_failed || !px || !caja)
+        return;
+    if (!s_dano_ps) {
+        ID3DBlob *code = NULL;
+        D3D11_BLEND_DESC bd;
+        D3D11_TEXTURE2D_DESC td;
+        D3D11_SUBRESOURCE_DATA sd;
+        ID3D11Texture2D *tex = NULL;
+        s_dano_failed = 1;
+        if (!compile("nv2a_dano_ps", s_dano_ps_src, "ps_5_0", &code))
+            return;
+        ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(code),
+                                       ID3D10Blob_GetBufferSize(code), NULL, &s_dano_ps);
+        ID3D10Blob_Release(code);
+        s_dano_cb = make_buffer(sizeof d, D3D11_BIND_CONSTANT_BUFFER);
+        memset(&bd, 0, sizeof bd);
+        bd.RenderTarget[0].BlendEnable = TRUE;
+        bd.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+        bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+        bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ZERO;
+        bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+        bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        ID3D11Device_CreateBlendState(s_dev, &bd, &s_dano_bs);
+        memset(&td, 0, sizeof td);
+        td.Width = (UINT)g_nv2a_dano_w;
+        td.Height = (UINT)g_nv2a_dano_h;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_IMMUTABLE;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        sd.pSysMem = px;
+        sd.SysMemPitch = td.Width * 2u;
+        sd.SysMemSlicePitch = 0;
+        if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, &sd, &tex))) {
+            ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tex, NULL, &s_dano_srv);
+            ID3D11Texture2D_Release(tex);
+        }
+        if (!s_dano_ps || !s_dano_cb || !s_dano_bs || !s_dano_srv)
+            return;
+        if (g_nv2a_cadena_px && g_nv2a_cadena_w > 0 && g_nv2a_cadena_h > 0) {
+            td.Width = (UINT)g_nv2a_cadena_w;
+            td.Height = (UINT)g_nv2a_cadena_h;
+            td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+            sd.pSysMem = g_nv2a_cadena_px;
+            sd.SysMemPitch = td.Width * 4u;
+            tex = NULL;
+            if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, &sd, &tex))) {
+                ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tex, NULL, &s_cadena_srv);
+                ID3D11Texture2D_Release(tex);
+            }
+            s_cadena_aspecto = (float)g_nv2a_cadena_w / (float)g_nv2a_cadena_h;
+        }
+        s_dano_failed = 0;
+    }
+    memset(d, 0, sizeof d);
+    d[0] = (float)r->x;
+    d[1] = (float)r->y;
+    d[2] = (float)r->w;
+    d[3] = (float)r->h;
+    d[4] = (float)g_nv2a_dano_w;
+    d[5] = (float)g_nv2a_dano_h;
+    d[6] = 4.0f;                        /* the glyphs' outlines overlap a little */
+    d[7] = s_cadena_aspecto;            /* the chain picture's width / height */
+    for (i = 0; i < DANO_N; i++) {
+        int k;
+        for (k = 0; k < 8; k++)
+            d[8 + 8 * i + k] = g_nv2a_dano[i][k];
+    }
+    for (i = 0; i < 12; i++) {
+        d[8 + 8 * DANO_N + 4 * i] = (float)caja[i][0];
+        d[9 + 8 * DANO_N + 4 * i] = (float)caja[i][1];
+    }
+    for (i = 0; i < CADENA_N; i++) {
+        int k;
+        for (k = 0; k < 12; k++)
+            d[8 + 8 * DANO_N + 48 + 12 * i + k] = s_cadena_srv ? g_nv2a_cadena[i][k] : 0.0f;
+    }
+    for (i = 0; i < 9; i++) {
+        int k;
+        for (k = 0; k < 8; k++)
+            d[8 + 8 * DANO_N + 48 + 12 * CADENA_N + 8 * i + k] = g_nv2a_cadena_cartas[i][k];
+    }
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_dano_cb, 0,
+                                       D3D11_MAP_WRITE_DISCARD, 0, &m)))
+        return;
+    memcpy(m.pData, d, sizeof d);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_dano_cb, 0);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, s_dano_bs, NULL, 0xFFFFFFFF);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_dano_ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_dano_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &s_dano_srv);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 1, 1, &s_cadena_srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 1, &s_blit_smp[1]);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    {
+        ID3D11ShaderResourceView *none = NULL;
+        ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);
+        ID3D11DeviceContext_PSSetShaderResources(s_ctx, 1, 1, &none);
+    }
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, NULL, NULL, 0xFFFFFFFF);
+}
