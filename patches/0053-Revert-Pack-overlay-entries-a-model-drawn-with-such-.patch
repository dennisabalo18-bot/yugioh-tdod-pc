     return e;
 }
 
-struct nv2a_tex_pack_entry *nv2a_tex_pack_find_overlay(uint64_t hash)
-{
-    unsigned m = atomic_load_explicit(&s_mask, memory_order_relaxed);
-    uint64_t key = hash ^ NV2A_TEX_PACK_OVERLAY_SALT;
-    unsigned lo = 0, hi = s_count;
-    if (!(m & PACK_ON))
-        return NULL;
-    while (lo < hi) {
-        unsigned mid = lo + (hi - lo) / 2;
-        if (s_entries[mid].hash < key)
-            lo = mid + 1;
-        else if (s_entries[mid].hash > key)
-            hi = mid;
-        else
-            return s_entries[mid].kind == XRTP_KIND_BUTTON && !s_entries[mid].bc3
-                   ? &s_entries[mid] : NULL;
-    }
-    return NULL;
-}
-
 struct nv2a_tex_pack_entry *nv2a_tex_pack_find(uint64_t hash, uint32_t guest_w,
                                                uint32_t guest_h)
 {
diff --git a/src/kernel/nv2a_tex_pack.h b/src/kernel/nv2a_tex_pack.h
index f2dd99e..7b5ecf9 100644
--- a/src/kernel/nv2a_tex_pack.h
+++ b/src/kernel/nv2a_tex_pack.h
@@ -119,13 +119,6 @@ uint64_t nv2a_tex_pack_button_key(uint64_t hash, int style, int art);
 /* The kind BUTTON entry of (hash, aspect) for the style and F6 now, or NULL. */
 struct nv2a_tex_pack_entry *nv2a_tex_pack_find_button(uint64_t hash, uint32_t guest_w,
                                                       uint32_t guest_h);
-/* rdr-port: a model drawn with a guest texture of this hash is replaced in
- * the keyboard style by a flat picture: the kind BUTTON entry keyed
- * hash ^ NV2A_TEX_PACK_OVERLAY_SALT (any aspect), or NULL. The backend
- * skips the model's batches and draws the picture over the box they cover
- * (the tutorial's 3D controller -> a keyboard and mouse). */
-#define NV2A_TEX_PACK_OVERLAY_SALT 0x4B424D4F55534531ull   /* "KBMOUSE1" */
-struct nv2a_tex_pack_entry *nv2a_tex_pack_find_overlay(uint64_t hash);
 /* Hits of nv2a_tex_pack_find, for the backends' statistics. */
 uint64_t nv2a_tex_pack_hits(void);
 
