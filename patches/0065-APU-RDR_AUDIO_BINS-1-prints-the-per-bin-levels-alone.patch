From c64efd2a29df268f212450982a6b8b57d6ab09bb Mon Sep 17 00:00:00 2001
From: adrianelmanya76 <adrianelmanya76@gmail.com>
Date: Fri, 6 Nov 2026 01:59:21 -0300
Subject: [PATCH 65/74] APU: RDR_AUDIO_BINS=1 prints the per-bin levels alone
 (no register trace), with the limiter's deepest cut per second

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/apu/apu_dsp.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/src/apu/apu_dsp.c b/src/apu/apu_dsp.c
index b4c2407..2c327a6 100644
--- a/src/apu/apu_dsp.c
+++ b/src/apu/apu_dsp.c
@@ -387,7 +387,7 @@ void mcpx_apu_update_dsp_preference(MCPXAPUState *d)
  * over -1 dB and lets it back up over about 150 ms, so the clamp is not
  * reached; quieter passages pass untouched. RDR_APU_LIMITER=0 turns it off
  * (A/B). */
-static float s_lim_gain = 1.0f;
+static float s_lim_gain = 1.0f, s_lim_min = 1.0f;   /* min: for [APU-MIXBIN] */
 
 static int limiter_on(void)
 {
@@ -409,6 +409,8 @@ static void limit(float *l, float *r)
         s_lim_gain = want;                          /* attack: at once */
     else
         s_lim_gain += (want - s_lim_gain) * rel;    /* release: smooth */
+    if (s_lim_gain < s_lim_min)
+        s_lim_min = s_lim_gain;
     *l *= s_lim_gain;
     *r *= s_lim_gain;
 }
@@ -421,8 +423,12 @@ static void dsp_bin_stats(MCPXAPUState *d,
     static float peak[NUM_MIXBINS];
     static unsigned frames, secs;
 
-    if (on < 0)
-        on = recomp_env_on(RENV_APU_TRACE) > 0;
+    if (on < 0) {
+        /* rdr-port: RDR_AUDIO_BINS=1 for these lines alone, without the
+         * register trace ("Medir audio.bat") */
+        const char *e = getenv("RDR_AUDIO_BINS");
+        on = recomp_env_on(RENV_APU_TRACE) > 0 || (e && *e == '1');
+    }
     if (!on)
         return;
     for (int b = 0; b < NUM_MIXBINS; b++)
@@ -434,9 +440,10 @@ static void dsp_bin_stats(MCPXAPUState *d,
     if (++frames % 1500)
         return;
     secs++;
-    fprintf(stderr, "[APU-MIXBIN] t=%us hrtf_submix=%u/%u/%u/%u hrtf_hr=%u",
-            secs, d->vp.hrtf_submix[0], d->vp.hrtf_submix[1],
+    fprintf(stderr, "[APU-MIXBIN] t=%us lim_min=%.1fdB hrtf_submix=%u/%u/%u/%u hrtf_hr=%u",
+            secs, 20.0 * log10(s_lim_min), d->vp.hrtf_submix[0], d->vp.hrtf_submix[1],
             d->vp.hrtf_submix[2], d->vp.hrtf_submix[3], d->vp.hrtf_headroom);
+    s_lim_min = 1.0f;
     for (int b = 0; b < NUM_MIXBINS; b++) {
         if (peak[b] > 0.0f)
             fprintf(stderr, " b%d:submix_hr%u,rms%.1f,pk%.1f", b,
-- 
2.55.0.windows.3

