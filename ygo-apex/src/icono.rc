// The game's icon (the glove, tools/icono.py) and its version information,
// like any Windows program.
#include <winver.h>

1 ICON "../../tools/launcher/yugioh.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Yu-Gi-Oh Port"
            VALUE "FileDescription", "Yu-Gi-Oh! The Dawn of Destiny - Port de PC"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Yu-Gi-Oh"
            VALUE "LegalCopyright", "Port de fans, sin fines de lucro"
            VALUE "OriginalFilename", "Yu-Gi-Oh.exe"
            VALUE "ProductName", "Yu-Gi-Oh! The Dawn of Destiny - Port de PC"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
